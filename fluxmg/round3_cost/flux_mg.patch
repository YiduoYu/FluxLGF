+    def build_HG(self):
+        """H = A W and G = A^T W (flat F N x K), assembled in differences like E: faces inside one region add exactly zero.
+        With them the balanced deflation needs no extra matvec: A q = H c and W^T A (q + z) = G^T (q + z)."""
+        L = self.levels[0]
+        F, K = L.F, self.K
+        N = int(np.prod(L.shape))
+        idx = np.arange(N).reshape(L.shape)
+        W = sp.csr_matrix((self.flat_w, (self.flat_keep, self.flat_lab)), shape=(F * N, K))
+        Hs, Gs = [], []
+        for f in range(F):
+            Wf = W[f * N:(f + 1) * N].tocsr()
+            has = np.diff(Wf.indptr) > 0
+            T = sp.csr_matrix((N, K))
+            for a, k in enumerate(L.faces):
+                lo, hi = [slice(None)] * 3, [slice(None)] * 3
+                lo[a], hi[a] = slice(None, -1), slice(1, None)
+                lo, hi = tuple(lo), tuple(hi)
+                ip, iq, v = idx[lo].ravel(), idx[hi].ravel(), k[f].ravel()
+                lp, lq = self.labels[f][lo].ravel(), self.labels[f][hi].ravel()
+                act = (has[ip] | has[iq]) & ~((lp == lq) & (lp >= 0))
+                if not act.any():
+                    continue
+                m = int(act.sum())
+                Dm = (Wf[ip[act]] - Wf[iq[act]]).tocsr()
+                S = sp.csr_matrix((v[act], (ip[act], np.arange(m))), shape=(N, m)) - sp.csr_matrix((v[act], (iq[act], np.arange(m))), shape=(N, m))
+                T = T + S @ Dm
+            Hf, Gf = T, T
+            for g in range(F):
+                Wg = W[g * N:(g + 1) * N]
+                Hf = Hf + sp.diags(L.C[..., f, g].ravel()) @ Wg
+                Gf = Gf + sp.diags(L.C[..., g, f].ravel()) @ Wg
+            Hs.append(Hf); Gs.append(Gf)
+        self.H = sp.vstack(Hs).tocsr(); self.H.eliminate_zeros()
+        self.G = sp.vstack(Gs).tocsr(); self.G.eliminate_zeros()
+        self.W = W
+        self.GtW = np.ascontiguousarray((self.G.T @ W).toarray())         # K x K: W^T A W evaluated through G
