+/* one colour of the red-black sweep, one field: same sums in the same order as point_sweep, boundary tests hoisted */
+static void point_sweep1(const Level *l, double *x, const double *rhs, int color) {
+    const int nz = l->nz, ny = l->ny, nx = l->nx;
+    const long nxy = (long)ny * nx;
+    const double *kz = l->kz, *ky = l->ky, *kx = l->kx, *Dinv = l->Dinv;
+    for (int z = 0; z < nz; z++)
+        for (int y = 0; y < ny; y++) {
+            int start = (z + y + color) & 1;
+            long base = IDX(l, z, y, 0);
+            const double *kxr = kx + ((long)z * ny + y) * (nx - 1) - base;      /* kxr[i] is the face between i and i+1 */
+            const double *kym = y > 0 ? ky + ((long)z * (ny - 1) + y - 1) * nx - base : NULL;
+            const double *kyp = y < ny - 1 ? ky + ((long)z * (ny - 1) + y) * nx - base : NULL;
+            const int zm = z > 0, zp = z < nz - 1;
+            for (int xx = start; xx < nx; xx += 2) {
+                long i = base + xx;
+                double s = rhs[i];
+                if (xx > 0) s += kxr[i - 1] * x[i - 1];
+                if (xx < nx - 1) s += kxr[i] * x[i + 1];
+                if (kym) s += kym[i] * x[i - nx];
+                if (kyp) s += kyp[i] * x[i + nx];
+                if (zm) s += kz[i - nxy] * x[i - nxy];
+                if (zp) s += kz[i] * x[i + nxy];
+                x[i] = Dinv[i] * s;
+            }
+        }
+}
